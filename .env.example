# ==============================================================================
# HELM: Autonomous Software Engineering Agent - Environment Configuration
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/helm_db
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/helm_db

# Redis Configuration (Job Queue & Event Pub/Sub)
REDIS_URL=redis://localhost:6379/0

# Model Provider Configuration (DeepSeek V4 Flash)
# Supported provider types: deepseek, openai, mock
MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Sandbox Execution Engine
# Supported: local_docker, local_process, remote
SANDBOX_PROVIDER=local_docker
DOCKER_SANDBOX_IMAGE=helm-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_CPU_LIMIT=2.0

# GitHub Integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=

# Policy & Approval Configuration
AUTO_APPROVE_SAFE_OPS=true
REQUIRE_APPROVAL_GIT_PUSH=true
REQUIRE_APPROVAL_PR_CREATE=true
MAX_SELF_CORRECTION_ITERATIONS=4

# Backend Security & Abuse Protection
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_RPM=180
RATE_LIMIT_TASKS_RPM=20
HELM_API_KEY=
MAX_REQUEST_BODY_BYTES=10485760
